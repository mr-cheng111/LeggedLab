<mujoco model="motion_replay_scene">
  <include file="{robot_xml}"/>

  <visual>
    <global azimuth="135" elevation="-18"/>
    <headlight diffuse="0.45 0.45 0.45" ambient="0.25 0.25 0.25" specular="0.2 0.2 0.2"/>
    <quality shadowsize="2048"/>
    <map znear="0.01" zfar="50"/>
    <rgba haze="0.70 0.78 0.86 1"/>
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.55 0.67 0.80" rgb2="0.05 0.06 0.08" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.23 0.25 0.27" rgb2="0.33 0.35 0.36" width="512" height="512" mark="edge" markrgb="0.48 0.50 0.52"/>
    <material name="grid_mat" texture="grid" texrepeat="8 8" reflectance="0.12" roughness="0.65"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="0 -3 5" dir="0.2 0.4 -1" diffuse="0.85 0.82 0.76" specular="0.25 0.25 0.25"/>
    <light name="fill_light" pos="-3 4 3" dir="0.6 -0.7 -1" diffuse="0.25 0.30 0.36" specular="0.05 0.05 0.05"/>
    <geom name="ground" type="plane" size="20 20 0.05" material="grid_mat"/>
    <camera name="motion_view" pos="2.6 -3.2 1.35" xyaxes="0.78 0.63 0 -0.18 0.22 0.96"/>
  </worldbody>
</mujoco>
